# Production Linux whisper.cpp paths
OPICT_WHISPER_BIN=/home/opc/tools/whisper.cpp/build/bin/whisper-cli
OPICT_WHISPER_MODEL=/home/opc/tools/whisper.cpp/models/ggml-base.en.bin
# Generate both values on the production server with:
# node scripts/init-opict-auth.mjs --env /home/opc/opict/.env
OPICT_APP_PASSWORD_HASH=scrypt$<generate-on-server>
OPICT_SESSION_SECRET=<generate-on-server>
TZ=Asia/Seoul

# Local Windows example:
# OPICT_WHISPER_BIN=C:/tools/whisper.cpp/whisper-cli.exe
# OPICT_WHISPER_MODEL=C:/tools/whisper.cpp/ggml-base.en.bin
